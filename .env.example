# ===========================
# Postgres container (consumed by docker-compose.yml's `db` service)
# ===========================
POSTGRES_USER=todoapp
POSTGRES_PASSWORD=todoapp_dev_password_change_me
POSTGRES_DB=todoapp

# ===========================
# API (apps/api)
# ===========================
DATABASE_URL=postgres://todoapp:todoapp_dev_password_change_me@localhost:5432/todoapp
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Set to 'production' to disable /docs (Swagger UI). Any other value (or unset)
# leaves /docs enabled. Spelling-strict: 'Production', 'staging', '' all leave
# /docs exposed — see apps/api/src/plugins/swagger.ts.
NODE_ENV=development

# Override the NODE_ENV gate to force-enable /docs. Use 'true' to force on,
# 'false' (or unset/empty) to leave the NODE_ENV check authoritative.
ENABLE_DOCS=false

# ===========================
# Web (apps/web)
# ===========================
NEXT_PUBLIC_API_URL=http://localhost:4000
